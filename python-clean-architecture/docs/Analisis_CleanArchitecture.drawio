          <mxGeometry x="1130" y="475" width="150" height="90" as="geometry" />
        </mxCell>

        <!-- SUBSISTEMA PERSISTENCIA & INFRAESTRUCTURA -->
        <mxCell id="R4I" value="«subsystem»&#xa;Capa Persistencia e Infraestructura (app/infra/db)" style="shape=folder;fontStyle=1;tabWidth=280;tabHeight=25;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="690" width="1250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="R4I1" value="«component»&#xa;SQLModelRolRepo&#xa;[repositories/rol.py]&#xa;Implementa consultas&#xa;y mapeo DBRol &lt;=&gt; Rol" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R4I2" value="«component»&#xa;SQLModelRolUoW&#xa;[unit_of_work/rol.py]&#xa;Maneja sesión única para&#xa;rol_repo + user_repo" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="740" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R4I3" value="«component»&#xa;RelationalModelDBRol&#xa;[models/rol.py]&#xa;Tabla &quot;roles&quot;&#xa;user_id: UUID FK UNIQUE&#xa;sa.UniqueConstraint(&quot;user_id&quot;)" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="740" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R4I4" value="«component»&#xa;PostgreSQL DBMS&#xa;Tablas users &amp; roles&#xa;Restricción FK ON DELETE CASCADE&#xa;Índice UNIQUE en user_id" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="740" width="270" height="80" as="geometry" />
        </mxCell>

        <!-- CONECTORES UML ESTÁNDAR -->
