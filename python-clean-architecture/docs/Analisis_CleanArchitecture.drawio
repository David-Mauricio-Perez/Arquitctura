        <!-- PUERTOS (INTERFACES) DEL DOMINIO -->
        <mxCell id="R4P_REPO" value="«interface»&#xa;RolRepo (Port)&#xa;+ save(rol: Rol)&#xa;+ get_by_id(id: ID)&#xa;+ get_by_name(name)&#xa;+ get_by_user_id(user_id)&#xa;+ update(rol) · delete(id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
