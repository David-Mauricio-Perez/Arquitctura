        <mxCell id="re6" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4A2" target="R4P_REPO">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
