        <mxCell id="re1" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4P1" target="R4IF">
