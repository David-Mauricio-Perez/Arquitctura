        <mxCell id="re10" value="«realize»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4I2" target="R4P_UOW">
          <mxGeometry relative="1" as="geometry" />
