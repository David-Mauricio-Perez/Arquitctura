        <mxCell id="R4P_UOW" value="«interface»&#xa;RolUnitOfWork (Port)&#xa;+ rol_repo: RolRepo&#xa;+ user_repo: UserRepo&#xa;+ commit() / rollback()&#xa;[Garantiza consistencia 1:1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
