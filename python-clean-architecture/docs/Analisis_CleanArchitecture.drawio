        <mxCell id="re7" value="contiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=10;" edge="1" parent="1" source="R4P_UOW" target="R4P_REPO">
