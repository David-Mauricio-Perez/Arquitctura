        <mxCell id="re5" value="«use» construye Rol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4A1" target="R4D1">
          <mxGeometry relative="1" as="geometry" />
