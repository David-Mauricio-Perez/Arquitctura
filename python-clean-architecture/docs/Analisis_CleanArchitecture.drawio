        <mxCell id="re2" value="«use» inyecta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4P2" target="R4A1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Realización de la interfaz de casos de uso -->
        <mxCell id="re3" value="«realize»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4A1" target="R4IF">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Casos de uso usan RolUnitOfWork (DIP) -->
        <mxCell id="re4" value="«use» (DIP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="R4A1" target="R4P_UOW">
